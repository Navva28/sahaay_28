# Sahaay Frontend Environment Configuration

# Backend API Endpoint
VITE_API_URL=http://localhost:5000

# Nexconn App Key (Client-safe public identifier from https://console.nexconn.ai/)
# NOTE: Never put NEXCONN_APP_SECRET here!
VITE_NEXCONN_APP_KEY=your_nexconn_app_key_here

# Supabase Client Configuration (Optional for direct read/auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
