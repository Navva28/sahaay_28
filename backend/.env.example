PORT=5000
NODE_ENV=development

# Nexconn Credentials (Obtained from https://console.nexconn.ai/)
# NOTE: The App Secret must NEVER be exposed in frontend code.
NEXCONN_APP_KEY=your_nexconn_app_key_here
NEXCONN_APP_SECRET=your_nexconn_app_secret_here

# Nexconn Server API Domain
# Primary Domain (default: https://api.nexconn.ai or specified in console)
NEXCONN_PRIMARY_API_DOMAIN=https://api.nexconn.ai
# Secondary Domain for failover (optional)
NEXCONN_SECONDARY_API_DOMAIN=

# Supabase Credentials (from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Client URL for CORS
CLIENT_URL=http://localhost:5173
